# Dedicated demo backend. Copy to .env.demo; keep it out of version control.
API_DOMAIN=api-demo.example.com
POSTGRES_DB=nexora_demo
POSTGRES_USER=nexora_demo
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_ALPHANUMERIC
DATABASE_URL=postgresql+psycopg2://nexora_demo:CHANGE_ME_RANDOM_ALPHANUMERIC@postgres:5432/nexora_demo
APP_ENV=production
AUTH_SECRET_KEY=CHANGE_ME_RANDOM_AT_LEAST_32_CHARACTERS
AUTH_COOKIE_SECURE=true
FRONTEND_ORIGINS=https://YOUR-PROJECT.vercel.app
DEMO_ENABLED=true
# The same secret must be configured in Vercel's server-only environment.
DEMO_PROXY_SECRET=CHANGE_ME_RANDOM_AT_LEAST_32_CHARACTERS
DEMO_DAILY_QUESTION_LIMIT=100
DEMO_DAILY_SESSION_LIMIT=50
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
DOCUMENT_STORAGE_DIR=/data/documents
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=CHANGE_ME_RANDOM_QDRANT_KEY
QDRANT_COLLECTION=nexora_demo_chunks
QDRANT_INFERENCE_MODE=local
QDRANT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ANSWER_MAX_TOKENS=512
OCR_PROVIDER=disabled
CHUNKING_STRATEGY=hierarchical
# Public guests cannot upload. Keep scanner checks fail-closed for other users.
MALWARE_SCAN_MODE=required
