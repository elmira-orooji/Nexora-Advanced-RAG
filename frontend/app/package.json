{
  "name": "nexora-web",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "lint": "eslint .",
    "test": "vitest run --configLoader native",
    "test:unit": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test e2e/auth.spec.ts e2e/upload.spec.ts e2e/chat.spec.ts",
    "test:e2e:accessibility": "playwright test e2e/accessibility-responsive.spec.ts",
    "test:pyramid": "npm run test:unit && npm run test:e2e:critical",
    "test:e2e:watch": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "preview": "vite preview --configLoader native"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@livekit/components-react": "^2.9.24",
    "@tailwindcss/vite": "4.2.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "framer-motion": "12.40.0",
    "i18next": "26.3.1",
    "livekit-client": "^2.23.0",
    "lucide-react": "1.14.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-dropzone": "15.0.0",
    "react-hook-form": "7.75.0",
    "react-hot-toast": "2.6.0",
    "react-i18next": "17.0.8",
    "react-icons": "5.6.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "6.30.3",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.7",
    "tailwind-scrollbar": "4.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@emnapi/wasi-threads": "1.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^24.12.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.1",
    "autoprefixer": "10.5.0",
    "eslint": "10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.13",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.1",
    "vite": "8.0.10",
    "vitest": "4.1.11"
  }
}
